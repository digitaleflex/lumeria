# Database Configuration
# PostgreSQL connection string (replace with your actual connection string)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Environment
NODE_ENV=development

# Better Auth Configuration
BETTER_AUTH_SECRET=your-super-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# API Configuration (for frontend - points to backend server)
VITE_API_URL=http://localhost:3001

# Resend API Key for Magic Link emails
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
